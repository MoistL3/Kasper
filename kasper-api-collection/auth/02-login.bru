meta {
  name: 02 Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.data.token);
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
}

tests {
  test("returns token and public user", function () {
    expect(res.body.data.token).to.be.a("string");
    expect(res.body.data.user.email).to.equal(bru.getVar("email"));
    expect(res.body.data.user).to.not.have.property("password");
  });
}

docs {
  Run "01 Register" first (or run the whole folder) so {{email}} and {{password}} exist.
}
