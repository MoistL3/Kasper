meta {
  name: 07 Register - role escalation ignored
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Sneaky",
    "email": "sneaky_{{$timestamp}}@kasper.dev",
    "password": "Passw0rd!123",
    "role": "admin"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("role: admin in the body is ignored", function () {
    expect(res.body.data.user.role).to.equal("member");
  });
}
