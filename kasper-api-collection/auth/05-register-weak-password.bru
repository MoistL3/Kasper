meta {
  name: 05 Register - weak password (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Weak Pass",
    "email": "weak_{{$timestamp}}@kasper.dev",
    "password": "123"
  }
}

assert {
  res.status: eq 400
  res.body.status: eq fail
}
