meta {
  name: 04 Register - duplicate email (409)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Kasper Tester",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 409
  res.body.status: eq fail
}
