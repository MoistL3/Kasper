meta {
  name: 08 Login - wrong password (401)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "definitely-wrong"
  }
}

assert {
  res.status: eq 401
  res.body.message: eq Invalid email or password
}
