meta {
  name: 01 Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Kasper Tester",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  // Fresh email every run so you never hit 409 by accident.
  // Runtime vars are shared by the requests that follow (run the folder top to bottom).
  bru.setVar("email", `tester_${Date.now()}@kasper.dev`);
  bru.setVar("password", "Passw0rd!123");
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("token", res.body.data.token);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq success
}

tests {
  test("returns user without password", function () {
    const user = res.body.data.user;
    expect(user.email).to.equal(bru.getVar("email"));
    expect(user.role).to.equal("member");
    expect(user).to.not.have.property("password");
  });

  test("returns a JWT", function () {
    expect(res.body.data.token).to.be.a("string");
    expect(res.body.data.token.split(".")).to.have.lengthOf(3);
  });
}
